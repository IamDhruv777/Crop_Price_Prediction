# ============================================================
# CROP PRICE PREDICTION — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# DATA.GOV.IN API (AGMARKNET)
# Get your key from: https://data.gov.in/user/api
# ----------------------------------------------------------
DATA_GOV_API_KEY=your_data_gov_api_key_here

# AGMARKNET resource ID for daily mandi prices
# Default resource (update if the official resource changes):
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ----------------------------------------------------------
# NASA POWER API
# No API key required for basic access.
# Set base URL in case the endpoint changes.
# ----------------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# ----------------------------------------------------------
# DATABASE (PostgreSQL + PostGIS)
# ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crop_price_prediction
POSTGRES_USER=cropuser
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SCHEMA=public

# Database URL (constructed from above variables, or override)
# DATABASE_URL=postgresql://cropuser:password@localhost:5432/crop_price_prediction

# ----------------------------------------------------------
# REDIS (optional — for caching)
# ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key
LOG_LEVEL=INFO

# ----------------------------------------------------------
# API SERVER
# ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# ----------------------------------------------------------
# DASHBOARD
# ----------------------------------------------------------
DASHBOARD_PORT=8501

# ----------------------------------------------------------
# MODEL SETTINGS
# ----------------------------------------------------------
MODEL_REGISTRY_PATH=./models
RANDOM_SEED=42

# ----------------------------------------------------------
# DATA PATHS
# ----------------------------------------------------------
DATA_RAW_PATH=./data/raw
DATA_INTERIM_PATH=./data/interim
DATA_PROCESSED_PATH=./data/processed
DATA_FEATURES_PATH=./data/features
